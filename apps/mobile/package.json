  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "repeatability:live": "node scripts/run-repeatability-benchmark.mjs",
    "repeatability:live:cases": "node scripts/run-repeatability-benchmark.mjs --case-file=scripts/repeatability-cases.json --runs=5 --min-cases=10",
    "nutrition:live:cases": "node scripts/run-nutrition-benchmark.mjs --case-file=scripts/nutrition-benchmark-cases.json --results-file=../../docs/benchmarks/macrolens-nutrition-benchmark-results-v1.json --release-gate",
    "nutrition5k:predict:live": "node scripts/predict-nutrition5k-live.mjs",
    "eas:build:ios:dev": "npx eas-cli build --platform ios --profile development",
    "eas:build:ios:testflight": "npx eas-cli build --platform ios --profile production --auto-submit",
    "eas:update:development": "npx eas-cli update --channel development --environment development",
    "eas:update:preview": "npx eas-cli update --channel preview --environment preview",
    "eas:update:production": "npx eas-cli update --channel production --environment production --message production-update",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "private": true
}
